    LTEXT           "ID Format:",IDC_STATIC,12,82,41,8
    CONTROL         "SJA1000",IDC_RADIO_ID_FORMAT,"Button",BS_AUTORADIOBUTTON | WS_DISABLED | WS_GROUP,57,82,44,10
